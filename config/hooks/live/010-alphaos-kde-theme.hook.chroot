#!/bin/bash
set -e

mkdir -p /etc/skel/.config

cat > /etc/skel/.config/kdeglobals <<'EOC'
[General]
ColorScheme=BreezeDark

[KDE]
LookAndFeelPackage=org.kde.breezedark.desktop

EOC

cat > /etc/skel/.config/plasmarc <<'EOC'
[Theme]
name=default
EOC

# Apply the default KDE/Plasma appearance for the live user
if id live >/dev/null 2>&1; then
    mkdir -p /home/live/.config
    cp /etc/skel/.config/kdeglobals /home/live/.config/kdeglobals
    cp /etc/skel/.config/plasmarc /home/live/.config/plasmarc
    chown -R live:live /home/live/.config
fi
