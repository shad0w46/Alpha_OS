#!/bin/sh
set -eu

echo "==> AlphaOS: removing Debian wallpaper artwork..."

# Remove known Debian wallpaper locations.
rm -rf /usr/share/backgrounds/debian
rm -rf /usr/share/wallpapers/debian
rm -rf /usr/share/wallpapers/desktop-base

# Remove Debian wallpaper collections if present.
rm -rf /usr/share/backgrounds/desktop-base
rm -rf /usr/share/wallpapers/desktop-base

# Remove wallpaper files from the desktop-base package if they remain.
if [ -d /usr/share/backgrounds ]; then
    find /usr/share/backgrounds \
        -type f \
        ! -path '/usr/share/backgrounds/alphaos/*' \
        -delete 2>/dev/null || true
fi

if [ -d /usr/share/wallpapers ]; then
    find /usr/share/wallpapers \
        -type f \
        ! -path '/usr/share/wallpapers/alphaos/*' \
        -delete 2>/dev/null || true
fi

# Recreate AlphaOS wallpaper directory in case a parent directory
# was removed by the cleanup above.
mkdir -p /usr/share/backgrounds/alphaos

echo "==> AlphaOS: Debian wallpaper artwork removed."
